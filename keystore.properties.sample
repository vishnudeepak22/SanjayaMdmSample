# Copy to keystore.properties and fill in. Paths are relative to the repo root.
# Generate the keystore once and keep it forever (the Device Owner app updates only with it):
#   keytool -genkeypair -v -keystore release.keystore -alias mdmsample \
#     -keyalg RSA -keysize 4096 -validity 10950
storeFile=release.keystore
storePassword=
keyAlias=mdmsample
keyPassword=
